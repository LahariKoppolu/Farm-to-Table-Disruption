      <column caption='Adjusted Hired Workers' datatype='real' name='[Calculation_114841850081918976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;High Restriction&quot; THEN [Total Hired Workers_Lahari] * 0.75&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Moderate Restriction&quot; THEN [Total Hired Workers_Lahari] * 0.90&#13;&#10;ELSE [Total Hired Workers_Lahari]&#13;&#10;END' />
      </column>
      <column caption='Adjusted Yield (Tons/Acre)' datatype='real' name='[Calculation_114841850082226177]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;High Restriction&quot; THEN [Yield (Tons/Acre)_Lahari] * 0.85&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Moderate Restriction&quot; THEN [Yield (Tons/Acre)_Lahari] * 0.95&#13;&#10;ELSE [Yield (Tons/Acre)_Lahari]&#13;&#10;END' />
      </column>
      <column caption='Adjusted Production(Tons)' datatype='real' name='[Calculation_114841850082598914]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;High Restriction&quot; THEN [Total Production (Tons)_Lahari] * 0.85&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Moderate Restriction&quot; THEN [Total Production (Tons)_Lahari] * 0.95&#13;&#10;ELSE [Total Production (Tons)_Lahari]&#13;&#10;END' />
      </column>
      <column caption='Adjusted Price (USD/Pound)' datatype='real' name='[Calculation_114841850082942979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;High Restriction&quot; THEN [Price (USD/Pound)] * 1.15&#13;&#10;ELSEIF [Parameters].[Parameter 1] = &quot;Moderate Restriction&quot; THEN [Price (USD/Pound)] * 1.05&#13;&#10;ELSE [Price (USD/Pound)]&#13;&#10;END' />
      </column>
      <column caption='Economic Loss' datatype='real' name='[Calculation_258957045856387072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Total Production (Tons)_Lahari] - [Calculation_114841850082598914]) * [Price (USD/Pound)]' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_258957045857271809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;High Restriction&quot; THEN &#13;&#10;   ([Total Production (Tons)_Lahari] - [Calculation_114841850082598914]) * [Price (USD/Pound)]&#13;&#10;END' />
